{
  "compilerOptions": {
    /* Opciones Base */
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Opciones de Estricteza (Requeridas) */
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Opciones del Proyecto */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,

    /* --- ESTA ES LA SECCIÓN CORREGIDA --- */
    "baseUrl": "./src", // <-- CAMBIO CLAVE: Le dice a TS dónde está la base
    "paths": {
      // <-- CAMBIO CLAVE: Quitamos el "./src/" de aquí
      "@domain/*": ["domain/*"],
      "@application/*": ["application/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*"], // Solo compila archivos dentro de src
  "exclude": ["node_modules", "dist"] // Ignora estas carpetas
}

