{
  "name": "states-service",
  "version": "1.0.0",
  "description": "Micro-servicio de estados y municipios con TypeORM y TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "start": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/server.js",
